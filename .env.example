# Docker development only. Never use these defaults in production.
NODE_ENV=development
ALLOW_REGISTRATION=true
DATABASE_URL=postgresql://mailcraft:development_only@postgres:5432/mailcraft
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-at-least-32-random-characters
MAILCHANNELS_DKIM_SELECTOR=mailchannels

# Optional authentication emails (one-time access, verification and recovery).
# Use a MailChannels API key and a sender on your verified domain.
AUTH_EMAIL_API_KEY=
AUTH_EMAIL_FROM_EMAIL=access@example.com
AUTH_EMAIL_FROM_NAME=MailCraft
AUTH_REQUIRE_EMAIL_VERIFICATION=false
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=

# Local browser and email links; use a reachable HTTPS origin for public tests.
APP_PUBLIC_URL=http://localhost:4200
DEV_SENDER_EMAIL=noreply@reclamofacil.com
DEV_TEST_RECIPIENT=rosonoem@gmail.com
