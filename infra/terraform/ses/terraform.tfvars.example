aws_region = "us-east-1"
environment = "production"
platform_domain = "zendix.site"
cloudflare_zone_id = "replace-with-cloudflare-zone-id"
cloudflare_api_token = "replace-with-zone-scoped-api-token"
app_public_url = "https://app.zendix.site"
enable_webhook_subscription = false
account_sender_email = "access@zendix.site"
media_domain = "media.zendix.site"
s3_force_destroy = false
