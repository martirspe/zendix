{
  "name": "mailcraft",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose up --build",
    "build": "npm run build --workspace @mailcraft/web && npm run build --workspace @mailcraft/api",
    "test": "tsx --tsconfig apps/api/tsconfig.json --test packages/email/src/*.test.ts packages/contacts/src/*.test.ts apps/api/src/*.test.ts",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "test:api": "node scripts/api-smoke.mjs",
    "test:smtp": "node scripts/smtp-smoke.mjs",
    "test:deploy": "node --test scripts/deploy.test.mjs"
  },
  "devDependencies": {
    "@types/css-tree": "^3.2.0",
    "@types/node": "^24.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.0"
  },
  "overrides": {
    "fastify": "^5.12.5",
    "deepmerge-ts": "^8.0.0",
    "vite": "^8.3.3"
  },
  "dependencies": {
    "css-tree": "^3.2.1",
    "domhandler": "^6.0.1",
    "htmlparser2": "^12.0.0"
  }
}
