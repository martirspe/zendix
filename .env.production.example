# Compose sets NODE_ENV, APP_PUBLIC_URL and the secret-file variables for the
# API. Keep this file limited to non-secret deployment settings.
APP_HOST=app.zendix.site
ACME_EMAIL=operations@example.com
JWT_SECRET_PATH=./deploy/secrets/jwt_secret
VAULT_KEY_PATH=./deploy/secrets/vault_key
DATABASE_PASSWORD_PATH=./deploy/secrets/database_password
REDIS_PASSWORD_PATH=./deploy/secrets/redis_password
AUTH_EMAIL_API_KEY_PATH=./deploy/secrets/auth_email_api_key
AUTH_EMAIL_FROM_EMAIL=access@example.com
AUTH_EMAIL_FROM_NAME=MailCraft
AUTH_REQUIRE_EMAIL_VERIFICATION=true
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=

# Loopback upstream when using scripts/deploy.sh with host Nginx.
WEB_PORT=8092

# Production registration is intentionally disabled by compose. Create the
# first owner with scripts/deploy.sh --bootstrap-owner.
